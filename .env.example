# Copia este archivo a .env y rellena solo lo que uses.
# Sin nada configurado Sentinel funciona completo en local: VT y la capa IA son opcionales.

# VirusTotal: clave gratis en https://www.virustotal.com (cuenta -> API key).
VT_API_KEY=

# ── Analista IA (opcional) ────────────────────────────────────────────
# Explica hallazgos en lenguaje claro. No detecta: interpreta lo ya hallado.
# AI_PROVIDER: auto | openai | gemini | ollama
AI_PROVIDER=auto

# OpenAI o compatible (Groq, OpenRouter...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Local con Ollama
OLLAMA_MODEL=
# OLLAMA_HOST=http://127.0.0.1:11434
